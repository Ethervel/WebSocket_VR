# ===========================================
# Server Configuration - COPY TO .env
# ===========================================
# Copy this file to .env and fill in real values
# NEVER commit .env to git!

# Database (MariaDB)
DB_HOST=localhost
DB_PORT=3306
DB_USER=vrmeeting_app
DB_PASSWORD=your_secure_password_here
DB_NAME=vrmeeting

# Authentication
JWT_SECRET=generate_a_very_long_random_string_here_at_least_64_characters
JWT_EXPIRES_IN=24h

# Server
WS_PORT=8080
NODE_ENV=production
